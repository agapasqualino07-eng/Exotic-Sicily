# ---------- SANITY (obbligatorio per modificare i contenuti) ----------
# Crea il progetto su https://www.sanity.io/manage e copia qui l'ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con permesso "Editor" (serve a: seed iniziale, iscritti newsletter, ordini)
SANITY_API_WRITE_TOKEN=
# Segreto scelto da te per il webhook di aggiornamento contenuti (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# ---------- SITO ----------
# URL pubblico (es. https://exoticdrysicily.com). Su Vercel è opzionale.
NEXT_PUBLIC_SITE_URL=

# ---------- STRIPE (opzionale: senza, il checkout diventa "ordina via email") ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
